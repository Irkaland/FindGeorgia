# Runtime
NODE_ENV=development
PROCESS_ROLE=api
PORT=8787
APP_ORIGIN=http://localhost:4173
API_BASE_URL=http://localhost:8787
PUBLIC_BASE_URL=http://localhost:4173
CORS_ALLOWED_ORIGINS=http://localhost:4173
TRUST_PROXY=false
DEPLOY_VERSION=development

# Database: sqlite for local development, postgres for staging/production
DATABASE_PROVIDER=sqlite
DATABASE_PATH=var/findgeorgia.sqlite
POSTGRES_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
POSTGRES_SSL=true
POSTGRES_SSL_REJECT_UNAUTHORIZED=false
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=10000

# Storage: filesystem for local development, s3 for Cloudflare R2 in production
STORAGE_PROVIDER=filesystem
PRIVATE_STORAGE_DIR=var/storage/private
PUBLIC_MEDIA_DIR=var/storage/public
OBJECT_STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=secret-manager-only
OBJECT_STORAGE_SECRET_ACCESS_KEY=secret-manager-only
OBJECT_STORAGE_PUBLIC_BUCKET=find-georgia-public
OBJECT_STORAGE_PRIVATE_BUCKET=find-georgia-private

# Separate cryptographic keys. Never reuse values in production.
SIGNED_URL_SECRET=replace-with-at-least-32-random-characters
DATA_ENCRYPTION_KEY=replace-with-a-different-32-character-random-key
SIGNED_URL_TTL_SECONDS=120
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_NAME=fg_session
CSRF_COOKIE_NAME=fg_csrf

# Upload scanning
MALWARE_SCANNER=development
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
MAX_EVIDENCE_BYTES=10485760
MAX_PUBLIC_IMAGE_BYTES=5242880

# Bot protection
BOT_PROVIDER=development
BOT_DEV_TOKEN=dev-bot-pass
TURNSTILE_SECRET_KEY=secret-manager-only
TURNSTILE_HOSTNAME=findgeorgia.ge
TURNSTILE_ACTION=public-intake
VITE_TURNSTILE_SITE_KEY=public-site-key

# Email and monitoring
EMAIL_PROVIDER=development
RESEND_API_KEY=secret-manager-only
EMAIL_FROM=Find Georgia <notifications@example.org>
ADMIN_NOTIFICATION_EMAIL=operations@example.org
ERROR_MONITOR_DSN=secret-manager-only
ERROR_MONITOR_TRACES_SAMPLE_RATE=0.1

# Jobs, bootstrap, and development guardrails
ENABLE_BACKGROUND_JOBS=false
EXPOSE_DEV_HELPERS=false
ALLOW_PRODUCTION_SEED=false
ADMIN_BOOTSTRAP_TOKEN_HASH=sha256-of-one-time-bootstrap-token
BOOTSTRAP_TOKEN=one-time-secret-not-stored-in-source-control
BOOTSTRAP_ADMIN_EMAIL=admin@example.org
BOOTSTRAP_ADMIN_PASSWORD=secret-manager-only
BOOTSTRAP_ADMIN_MFA_SECRET=base32-secret-manager-only

# Frontend build target when API is on a separate HTTPS origin
VITE_API_BASE_URL=http://localhost:8787

# Legacy encrypted SQLite backup only. PostgreSQL production uses managed PITR plus logical exports.
BACKUP_DIR=var/backups
BACKUP_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
