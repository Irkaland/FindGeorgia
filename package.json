{
  "name": "findgeorgia",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node scripts/dev.mjs",
    "dev:ui": "vite preview --configLoader runner --port 4173",
    "dev:hot": "vite --configLoader runner --port 4173",
    "dev:api": "node server/index.js",
    "build": "vite build --configLoader runner && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview --configLoader runner",
    "start": "node server/index.js",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node server/seed.js",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs",
    "db:export-sqlite": "node scripts/export-sqlite.mjs",
    "db:import-postgres": "node scripts/import-postgres.mjs",
    "db:migrate-media": "node scripts/migrate-media.mjs",
    "db:verify-migration": "node scripts/verify-migration.mjs",
    "backup": "node scripts/backup.mjs",
    "backup:postgres": "node scripts/postgres-backup.mjs",
    "restore": "node scripts/restore.mjs",
    "restore:postgres-drill": "node scripts/postgres-restore-drill.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:backend": "node --test tests/backend-*.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "worker": "node server/worker.js",
    "check:production": "node scripts/production-check.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/s3-request-presigner": "^3.883.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/node": "^10.70.0",
    "@vitejs/plugin-react": "5.0.4",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "file-type": "^22.0.2",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "otplib": "^13.5.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "^0.35.3",
    "vite": "6.4.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  }
}
